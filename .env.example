# NegoZaar Environment Variables Template
NODE_ENV=development
PORT=3000

# Base App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security & Encryption (Must be at least 32 characters)
ENCRYPTION_KEY=your-32-characters-minimum-secret-encryption-key
SESSION_JWT_SECRET=your-32-characters-minimum-session-jwt-secret

# AI Negotiation Provider (Options: mock | openai | gemini | anthropic)
# Default is 'mock' for local development & deterministic integration testing without incurring API costs
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Shopify App Credentials (Configured in Phase 2 for live OAuth & webhook handshake)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-domain.ngrok-free.app

# Stripe Billing (Configured in Phase 2 for B2B SaaS Subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
